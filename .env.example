# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL (safe local-development values only)
POSTGRES_DB=alpha_radar
POSTGRES_USER=alpha_radar
POSTGRES_PASSWORD=alpha_radar_local
DATABASE_URL=postgresql+asyncpg://alpha_radar:alpha_radar_local@postgres:5432/alpha_radar

# Redis / worker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Market data (external ingestion is opt-in; mock is deterministic)
MARKET_DATA_PROVIDER=mock
MARKET_DATA_INGESTION_ENABLED=false
MARKET_DATA_QUOTE_FRESHNESS_SECONDS=90
MARKET_DATA_FUTURE_TOLERANCE_SECONDS=30
MARKET_DATA_HTTP_TIMEOUT_SECONDS=10
COINBASE_EXCHANGE_API_URL=https://api.exchange.coinbase.com
